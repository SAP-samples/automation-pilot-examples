              "resourceGroup": "$(.execution.input.space)",
              "password": "$(.execution.input.password)",
              "resourceName": "$(.execution.input.app)",
              "region": "$(.execution.input.region)",
              "user": "$(.execution.input.user)",
              "bindingsNumber": "100",
              "subAccount": "$(.execution.input.org)",
              "identityProvider": "$(.execution.input.identityProvider)"
            },
            "alias": "getBindings",
            "description": "Get service bindings for the application",
            "progressMessage": null,
            "initialDelay": null,
            "pause": null,
            "when": null,
            "validate": null,
            "autoRetry": null,
            "repeat": null,
            "errorMessages": [],
            "dryRun": null
          },
          {
            "execute": "utils-sapcp:ForEach:2",
            "input": {
              "inputMapping": "{\"password\":\"$(.execution.input.password)\",\"bindingId\":\"$(.getBindingCredentials.current.item.id)\",\"instanceName\":\"$(.getBindingCredentials.current.item.instanceName)\",\"region\":\"$(.execution.input.region)\",\"user\":\"$(.execution.input.user)\",\"identityProvider\":\"$(.execution.input.identityProvider)\"}",
              "inputs": "$(.getBindings.output.bindings)",
              "command": "examples-<<<TENANT_ID>>>:GetCfServiceBindingDetails:1"
            },
            "alias": "getBindingCredentials",
            "description": "Get credentials for each service binding",
            "progressMessage": null,
            "initialDelay": null,
            "pause": null,
            "when": null,
            "validate": null,
            "autoRetry": null,
            "repeat": null,
            "errorMessages": [],
            "dryRun": null
          },
          {
            "execute": "utils-sapcp:Void:1",
            "input": {
              "message": "$(.getBindingCredentials.output.outputs\n   | map({ id: .bindingId, instanceName: .instanceName, certificate: .credentials.certificate // .credentials.clientcert // .credentials.sslcert // .credentials.uaa.certificate // .credentials.x509.certificate // .credentials.oauth.certificate })\n   | filter(.certificate != null)\n)"
            },
            "alias": "extractCertificates",
            "description": "Extract certificates from binding credentials",
            "progressMessage": null,
            "initialDelay": null,
            "pause": null,
            "when": null,
            "validate": null,
            "autoRetry": null,
            "repeat": null,
            "errorMessages": [],
            "dryRun": null
          },
          {
            "execute": "utils-sapcp:ForEach:2",
            "input": {
              "inputMapping": "{\"certificate\":\"$(.checkCertificates.current.item.certificate)\"}",
              "inputs": "$(.extractCertificates.output.message | toArray)",
              "command": "utils-sapcp:ParseCertificate:1"
            },
            "alias": "checkCertificates",
            "description": "Extract the metadata for each certificate from binding credentials",
            "progressMessage": "Checking application '$(.execution.input.app)'...",
            "initialDelay": null,
            "pause": null,
            "when": {
              "semantic": "OR",
              "conditions": [
                {
                  "semantic": "OR",
                  "cases": [
                    {
                      "expression": "$(.extractCertificates.output.message | toArray | length)",
                      "operator": "GREATER_THAN",
                      "semantic": "OR",
                      "values": [
                        "0"
                      ]
                    }
                  ]
                }
              ]
            },
            "validate": null,
            "autoRetry": null,
            "repeat": null,
            "errorMessages": [],
            "dryRun": null
          },
          {
            "execute": "utils-sapcp:Void:1",
            "input": {
              "message": "$(zip($.extractCertificates.output.message | toArray; $.checkCertificates.output.outputs | toArray)\n  | toArray\n  | map({ id: .[0].id, instanceName: .[0].instanceName, subjectDn: .[1].subjectDn, issuerDn: .[1].issuerDn, isExpired: .[1].isExpired, daysUntilExpiry: .[1].daysUntilExpiry, certificateChain: .[1].certificateChain})\n)"
            },
            "alias": "enrichCertificateResults",
            "description": "Enrich the binding id, instance name with the certificate which belongs to them",
            "progressMessage": null,
            "initialDelay": null,
            "pause": null,
            "when": null,
            "validate": null,
            "autoRetry": null,
            "repeat": null,
            "errorMessages": [],
            "dryRun": null
          },
          {
            "execute": "utils-sapcp:Void:1",
            "input": {
              "message": "$(.enrichCertificateResults.output.message\n    | toArray \n    | filter(.isExpired == true or (.daysUntilExpiry != null and .daysUntilExpiry < $.execution.input.expirationThreshold))\n)"
            },
            "alias": "buildCertificateReport",
            "description": "Filter only the certificate which are expiring less than the expiration threshold entered as input or have been already expired",
            "progressMessage": null,
            "initialDelay": null,
            "pause": null,
            "when": null,
            "validate": null,
            "autoRetry": null,
            "repeat": null,
            "errorMessages": [],
            "dryRun": null
          }
        ],
        "listeners": []
      },
